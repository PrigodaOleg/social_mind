<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: allow cleartext HTTP to the local Firebase emulator suite.
     The android emulator reaches host loopback services via 10.0.2.2. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Физическое устройство: порты эмуляторов проброшены adb reverse
             на loopback устройства (tool/run_device_tests.sh). -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

