rules_version = '2';

// Правила Cloud Firestore для CloudFirestoreStorage
// (lib/remote_storage/cloud_firestore.dart).
//
// Пока пермиссивные: любой аутентифицированный пользователь имеет полный
// доступ. TODO: ужесточить до per-user (участники домена / владелец модели).

service cloud.firestore {
  // Стандартный префикс для подпапок с данными (если будут использоваться).
  match /databases/{database}/documents {
    // Сериализованные модели.
    match /models/{id} {
      // TODO: per-user политики вместо общего "request.auth != null".
      allow read, write: if request.auth != null;
    }

    // Реестры изменений (metadata + transactions/<idx> + lastIdx).
    match /registries/{id} {
      // TODO: per-user политики вместо общего "request.auth != null".
      allow read, write: if request.auth != null;

      match /transactions/{idx} {
        allow read, write: if request.auth != null;
      }
    }

    // Raw storage (приглашения и т.п.) использует составные id в одной коллекции.
    match /invitations_data/{doc} {
      // TODO: per-user политики вместо общего "request.auth != null".
      allow read, write: if request.auth != null;
    }
  }
}
